{
  "version": "1.0",
  "name": "SupplyChain Sentinel Evaluation Benchmark v1",
  "description": "8 representative edge cases testing supplier identity, quote verification, wire syndication, null exposure safety, and policy guardrails.",
  "cases": [
    {
      "id": "CASE-01",
      "name": "Genuine Relevant Critical Disruption",
      "target_supplier": {
        "name": "Silicon Foundry Dresden GmbH",
        "aliases": ["SFD", "Dresden Fab"],
        "country": "Germany",
        "official_domains": ["silicon-dresden.de"],
        "parts": [
          {
            "part_name": "Automotive Microcontroller MCU-4",
            "inventory_coverage_days": 14,
            "typical_lead_time_days": 60,
            "criticality": "high"
          }
        ]
      },
      "sources": [
        {
          "url": "https://press.silicon-dresden.de/statements/cleanroom-fire",
          "publisher": "Silicon Foundry Dresden Press",
          "domain": "silicon-dresden.de",
          "published_date": "2026-10-12",
          "text": "Silicon Foundry Dresden GmbH experienced a severe cleanroom fire on Tuesday. Fab 1 cleanroom repairs and equipment recalibration are estimated to require 45 days before production resumes."
        },
        {
          "url": "https://reuters.com/business/semiconductors/dresden-cleanroom-fire",
          "publisher": "Reuters",
          "domain": "reuters.com",
          "published_date": "2026-10-13",
          "text": "Reuters reports Silicon Foundry Dresden GmbH experienced a severe cleanroom fire on Tuesday. German industrial authorities are inspecting the cleanroom blaze."
        },
        {
          "url": "https://techwires.de/reuters-syndicated-dresden-fire",
          "publisher": "TechWires Germany",
          "domain": "techwires.de",
          "published_date": "2026-10-13",
          "text": "According to Reuters, Silicon Foundry Dresden GmbH experienced a severe cleanroom fire on Tuesday. Semiconductor wafer deliveries face delay."
        }
      ],
      "expected_identity_status": "confirmed",
      "expected_lineage_group_count": 2,
      "expected_independent_sources": 2,
      "expected_disruption_days": 45,
      "expected_inventory_gap_days": 31,
      "expected_policy_recommendation": "urgent_human_review",
      "should_escalate": true,
      "notes": "Reuters and TechWires represent syndicated wire reporting. Gap = 45 - 14 = 31 days on high-criticality component triggers P-005."
    },
