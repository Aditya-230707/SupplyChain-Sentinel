# ==============================================================================
# SupplyChain Sentinel — Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# Values in this file are defaults or placeholders — NEVER commit real secrets.
# ==============================================================================

# ---- Application -------------------------------------------------------------
APP_NAME="SupplyChain Sentinel"
APP_ENV=development                      # development | test | production
# In production, set to a cryptographically strong 32+ character random string:
APP_SECRET_KEY=change-me-to-a-random-32-char-string
LOG_LEVEL=INFO                           # DEBUG | INFO | WARNING | ERROR
REQUEST_ID_HEADER=X-Request-ID

# ---- Database ----------------------------------------------------------------
# SQLite default (zero setup, stored locally):
DATABASE_URL=sqlite+aiosqlite:///./sentinel.db
# PostgreSQL example (for deployed production demo):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sentinel

# ---- LLM Provider (Nebius Token Factory + NVIDIA Nemotron) -------------------
# Choices: nebius | fake
# In production, LLM_PROVIDER must be 'nebius'. 'fake' is strictly for offline tests.
LLM_PROVIDER=nebius
NEBIUS_API_KEY=REPLACE_WITH_YOUR_NEBIUS_API_KEY
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Model: nvidia/Nemotron-3_5-Lightning
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning

# ---- Search / Content Provider (Tavily) --------------------------------------
# Obtain API key from: https://tavily.com
TAVILY_API_KEY=REPLACE_WITH_YOUR_TAVILY_API_KEY
TAVILY_MAX_RESULTS=8
TAVILY_SEARCH_DEPTH=advanced             # basic | advanced

# ---- Pipeline Safety Caps & Timeouts -----------------------------------------
MAX_SEARCHES_PER_RUN=6
MAX_RESULTS_PER_SEARCH=8
MAX_CONTENT_CHARS=12000
MAX_MODEL_RETRIES=1                       # bounded retry on transient failure
MAX_CONCURRENT_INVESTIGATIONS=3
INVESTIGATION_TIMEOUT_SECONDS=300

# ---- Web / CORS --------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Dev Gates ---------------------------------------------------------------
# Set to 'true' only when deliberately running live provider smoke tests.
ALLOW_LIVE_SMOKE_TESTS=false
