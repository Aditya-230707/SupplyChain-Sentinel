# ============================================================
# SupplyChain Sentinel — Environment Configuration Example
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ---- Application -------------------------------------------
APP_ENV=development                        # development | production
APP_SECRET_KEY=change-me-to-a-random-32-char-string
LOG_LEVEL=INFO                             # DEBUG | INFO | WARNING | ERROR
REQUEST_ID_HEADER=X-Request-ID

# ---- Database ----------------------------------------------
# SQLite (local dev — just a path)
DATABASE_URL=sqlite+aiosqlite:///./sentinel.db
# PostgreSQL example (for deployed demo):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sentinel

# ---- LLM Provider ------------------------------------------
# Choices: nebius | ollama | fake
#
# Production / Demo (Nebius Token Factory + NVIDIA Nemotron):
LLM_PROVIDER=nebius
NEBIUS_API_KEY=REPLACE_WITH_YOUR_NEBIUS_API_KEY
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Verify the exact model ID from: https://api.tokenfactory.nebius.com/v1/models
# Common IDs: nvidia/Nemotron-3_5-Lightning  |  nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning

# Local development only (set LLM_PROVIDER=ollama to use)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# ---- Search / Content Provider -----------------------------
# Obtain from: https://tavily.com
TAVILY_API_KEY=REPLACE_WITH_YOUR_TAVILY_API_KEY
TAVILY_MAX_RESULTS=8
TAVILY_SEARCH_DEPTH=advanced             # basic | advanced

# ---- Pipeline Caps (safety) --------------------------------
MAX_SEARCHES_PER_RUN=6
MAX_RESULTS_PER_SEARCH=8
MAX_CONTENT_CHARS=12000
MAX_MODEL_RETRIES=1                       # one retry on failure, then fail visibly
MAX_CONCURRENT_INVESTIGATIONS=3
INVESTIGATION_TIMEOUT_SECONDS=300

# ---- CORS --------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Dev-only smoke test gate ------------------------------
# Set to true only when you have credentials and authorize API spend
ALLOW_LIVE_SMOKE_TESTS=false
